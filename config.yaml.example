loglevel: info

inverters:
- enabled: true
  host: 192.168.0.10
  port: 8000
  serial: 5555555555
  datalog: 2222222222 # Replace with your actual datalog serial
  read_timeout: 900 # seconds to wait for data from inverter before timing out and reconnecting. Default is 900s (15 minutes).
  poll_interval_seconds: 60 # Seconds between polling inverter for input registers. Set to 0 or omit to disable. Default: disabled
  read_only: false # If true, prevents any commands that change inverter settings. Default: false
  heartbeats: false
  publish_holdings_on_connect: false
- enabled: false
  host: 192.168.0.163
  port: 8000
  serial: 9999999999
  datalog: 3333333333
  heartbeats: false
  publish_holdings_on_connect: false

databases:
- enabled: false
  url: postgres://lxp:lxp@localhost/lxp
  # url: mysql://lxp:lxp@localhost/lxp
  # url: sqlite://lxp.db

mqtt:
  enabled: true
  host: localhost
  port: 1883
  username:
  password:
  namespace: lxp
  homeassistant:
    enabled: true
    prefix: homeassistant

influx:
  enabled: true
  url: http://localhost:8086
  username:
  password:
  database: lxp

scheduler:
  enabled: false
  timesync_cron: "0 0 * * *"
